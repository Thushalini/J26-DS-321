# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real keys.
#
# Nothing is required yet. Add variables here (with empty values)
# as soon as the code starts needing them.

GITHUB_TOKEN=
# Supabase/PostgreSQL: postgresql://user:password@host:5432/postgres   (empty = local SQLite file)
DATABASE_URL=

# Code an EXAMINER must type when registering (examiners can read all feedback).
# Students and supervisors don't need it. Empty = nobody can register as examiner.
STAFF_CODE=

# Email for "Forgot password" reset codes. Empty SMTP_HOST = the code is printed in the
# backend console instead (fine for local runs). Gmail: smtp.gmail.com, port 587, an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

GEMINI_API_KEY=
GEMINI_MODEL=
# Optional. Seconds before a slow Gemini call is given up (default 30).
GEMINI_TIMEOUT_SECONDS=
# Optional. Empty = the model's default. 0 = thinking off (only some models allow it).
GEMINI_THINKING_BUDGET=
GROQ_API_KEY=
GROQ_MODEL=
# Optional. Seconds before a slow Groq call is given up (default 30).
GROQ_TIMEOUT_SECONDS=
# Optional. low / medium / high for reasoning models such as gpt-oss. Empty = the model's default.
GROQ_REASONING_EFFORT=

# Component 1 language model: groq or gemini. Empty = Groq if GROQ_API_KEY is set, else Gemini.
C1_LLM_PROVIDER=
# Component 1 extraction: hybrid (default: rules first, the language model only when they find
# nothing), rules (never call it), or llm (always call it). Without any key it is always rules.
C1_EXTRACTOR_MODE=

